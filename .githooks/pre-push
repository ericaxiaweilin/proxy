#!/bin/bash
# R16.11: pre-push hook. Runs the full gate matrix: build, tests,
# live-server e2e, and drift. The live e2e requires a server to be
# running on $PROXY_API_BASE_URL (default http://127.0.0.1:4100).
# If the server is not running, the gate fails and the push is
# rejected — this is the trade-off we made to stop pushing binaries
# that the simulator can never reach.
#
# Use `git push --no-verify` to bypass the hook if you have a
# documented reason.

set -e
cd "$(git rev-parse --show-toplevel)"

bash scripts/gate.sh
