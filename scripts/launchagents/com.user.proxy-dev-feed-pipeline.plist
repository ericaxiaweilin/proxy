<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  dev-feed-pipeline — 开发用 feed 管线，每 5 分钟发一条文本帖文（并滚动补一个新用户）。

  DEV-ONLY：这是纯开发辅助，删掉这个 plist + apps/api-go/cmd/devdata 里的 feed-pipeline
  就完事，不影响产品代码。用户要求「后期删除」，所以它独立于 app 与启动种子。

  go 用绝对路径：launchd 不读 shell profile，PATH 只有下面 EnvironmentVariables 那一份，
  写 `go` 会在每个 tick 变成 "command not found" —— 而这正是 DEV-FEED-PIPELINE-001
  那条「最新一帖必须新鲜」要抓的静默失败。

  StartInterval 而不是 StartCalendarInterval：管线的目的是"一直有新内容"，
  机器睡眠/错过的 tick 会在唤醒后补跑，StartCalendarInterval 则会跳过整点。
  5 分钟 = 300 秒。

  不要加 RunAtLoad：launchd 加载时立刻跑一次会和 dev-api 的启动赛跑
  （那时 API 可能还没起来）。第一次执行由 StartInterval 负责。
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.user.proxy-dev-feed-pipeline</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>-lc</string>
    <string>cd /Users/thanhhuyennguyen/proxy &amp;&amp; /opt/homebrew/bin/go -C apps/api-go run ./cmd/devdata feed-pipeline &gt;&gt; "$HOME/Library/Logs/proxy/dev-feed-pipeline.log" 2&gt;&amp;1</string>
  </array>

  <key>StartInterval</key>
  <integer>300</integer>

  <key>RunAtLoad</key>
  <false/>

  <key>StandardOutPath</key>
  <string>/Users/thanhhuyennguyen/Library/Logs/proxy/dev-feed-pipeline.log</string>

  <key>StandardErrorPath</key>
  <string>/Users/thanhhuyennguyen/Library/Logs/proxy/dev-feed-pipeline.err.log</string>

  <key>WorkingDirectory</key>
  <string>/Users/thanhhuyennguyen/proxy</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
</dict>
</plist>
