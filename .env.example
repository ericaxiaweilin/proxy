NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=4100
DATABASE_URL=postgres://proxy:proxy@localhost:5432/proxy
REDIS_URL=redis://localhost:6379
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_BUCKET=proxy-quarantine
OBJECT_STORAGE_ACCESS_KEY=proxy
OBJECT_STORAGE_SECRET_KEY=proxysecret

# Local development only. Do not enable this provider in production.
# PROXY_LOGIN_PROVIDER=simulated
# PROXY_SIMULATED_OTP_CODE=123456
# EXPO_PUBLIC_LOGIN_MODE=simulated
# EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:4100

# Operator 门禁白名单：逗号分隔的 principal id，可执行特权命令
# （能力核验 / 贡献审核 / 发奖 / 媒体就绪覆盖）。未配置时 fail-closed 全部拒绝。
# PROXY_OPERATOR_PRINCIPALS=prin_xxx,prin_yyy

# Model Stack（公共模型底座）。业务侧只发任务 ID，模型选择/Provider/凭证/failover 由底座负责。
# 三项任一缺失时适配器 fail-closed（AI 能力不可用，不降级伪造结果）。
# MODELSTACK_CONTROL_PLANE_URL=http://100.96.188.77:14041
# MODELSTACK_GATEWAY_URL=<底座下发的业务网关地址，OpenAI 兼容>
# MODELSTACK_GATEWAY_API_KEY=<底座下发的业务网关凭证，勿入库勿入日志>
# 远程底座不可达时的本地开发模式：读取 Pi provider registry，不把密钥复制进项目。
# MODELSTACK_USE_PI_CONFIG=true
# MODELSTACK_PI_MODELS_PATH=/Users/<user>/.pi/agent/models.json
# MODELSTACK_PI_SETTINGS_PATH=/Users/<user>/.pi/agent/settings.json
