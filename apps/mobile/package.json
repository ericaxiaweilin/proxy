{
  "name": "@proxy/mobile",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "tsc -p tsconfig.json --noEmit",
    "start": "expo start",
    "android": "bash ./scripts/dev-android.sh",
    "android:dev": "bash ./scripts/dev-android.sh",
    "android:emulator": "bash ./scripts/start-android-emulator.sh",
    "android:bootstrap": "bash ./scripts/bootstrap-android-dev.sh",
    "android:release-test": "bash ./scripts/install-simulator-release.sh",
    "android:simulator": "bash ./scripts/install-simulator-release.sh",
    "ios": "bash ./scripts/dev-ios.sh",
    "ios:dev": "bash ./scripts/dev-ios.sh",
    "ios:bootstrap": "bash ./scripts/bootstrap-ios-dev.sh",
    "doctor:delivery": "bash ./scripts/doctor-delivery.sh",
    "scope": "bash ./scripts/change-scope.sh",
    "native:prebuild": "expo prebuild"
  },
  "dependencies": {
    "@json-render/core": "^0.20.0",
    "@json-render/react-native": "^0.20.0",
    "@proxy/contracts": "workspace:*",
    "expo": "~57.0.12",
    "expo-audio": "~57.0.4",
    "expo-auth-session": "^57.0.8",
    "expo-clipboard": "~57.0.2",
    "expo-crypto": "^57.0.1",
    "expo-file-system": "~57.0.5",
    "expo-gl": "~57.0.2",
    "expo-glass-effect": "^57.0.1",
    "expo-image": "57.0.3",
    "expo-image-picker": "~57.0.12",
    "expo-location": "^57.0.14",
    "expo-secure-store": "~57.0.1",
    "expo-speech-recognition": "56.0.1",
    "expo-system-ui": "~57.0.2",
    "expo-video": "^57.0.2",
    "expo-web-browser": "^57.0.2",
    "react": "19.2.3",
    "react-native": "0.86.2",
    "react-native-image-viewing": "0.2.2",
    "react-native-maps": "^1.29.0",
    "react-native-qrcode-svg": "6.3.24",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-svg": "15.15.4",
    "react-native-view-shot": "^5.1.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@expo/config-plugins": "~57.0.7",
    "@types/node": "^22.15.21",
    "@types/react": "~19.2.18",
    "typescript": "^6.0.3",
    "vitest": "^3.2.4"
  }
