# 服务器侧环境变量模板。cp 成 infrastructure/server/.env 后填真值；
# .env 不进 git（仓库规则：凭据不入库），模板里一律占位。
#
# 这台机器上跑的是「只在 Tailscale 网内可达」的后端，不是公网生产：
# 登录走 simulated OTP、媒体落本地卷。下面每一项都写了「为什么这样设」，
# 改成生产形态时照着她反着改，不要凭手感删行。

# ---- compose 自己用的（也顺手进容器，无害）----
PROXY_PG_USER=proxy
# 【必填】随机值：openssl rand -hex 16
PROXY_PG_PASSWORD=CHANGE_ME_pg_password
PROXY_PG_DB=proxy

# API 只绑这个地址。填 Tailscale 网口 IP（100.64.0.0/10 段）——
# 填 0.0.0.0 会把后端开整台机器的所有网口，这台机器上还跑着别的项目。
PROXY_BIND_IP=100.96.188.77

# ---- 进程配置（镜像里已给默认值，这里只覆盖需要显式声明的）----
# KMS：32 字节 hex。不设时进程用「随机内存密钥」—— 重启后被加密的字段就解不开了，
# 所以这台机器上必须固定一个。openssl rand -hex 32
KMS_LOCAL_KEY=CHANGE_ME_64_hex_chars

# 登录：这台机器上没有邮件/短信凭据（用户裁决：凭据不出本机）。
# simulated = 任意手机号/邮箱 + 固定验证码都能过，所以 API 只能绑 Tailscale 口。
PROXY_LOGIN_PROVIDER=simulated
PROXY_SIMULATED_OTP_CODE=135790

# 下面这些**故意留空**，行为与本机 dev 一致，不是漏配：
# · PROXY_OPERATOR_PRINCIPALS 不设 = 所有特权命令（能力核验/贡献审核/发奖/媒体就绪覆盖）拒绝。
# · OBJECT_STORAGE_* 不设 = 媒体走本地卷 /var/lib/proxy/media（compose 里 api 与 worker 共享）。
# · PROXY_DEMAND_GATES 不设 = 发布 fail-closed 到 PENDING。
# · MODELSTACK_* 不设 = AI 能力走确定性 stub，不伪造模型结果。要接真底座就在下面三行填
#   （底座就在这台机器上：control plane 14041，LiteLLM gateway 127.0.0.1:14040）。
#MODELSTACK_CONTROL_PLANE_URL=http://100.96.188.77:14041
#MODELSTACK_GATEWAY_URL=http://100.96.188.77:14040
#MODELSTACK_GATEWAY_API_KEY=
# · 真邮箱/短信：换 PROXY_LOGIN_PROVIDER=smtp|sms 并补齐 apps/api-go/PRODUCTION.md 的表。
# · WALLET_SIMULATED_RECHARGE=1 是钱包模拟充值，dev 联调才开。
# · PROXY_OUTBOX_DELIVERY：compose 里默认 enabled；设 unavailable 可停外发不停 worker。
